# ==================== 运行模式 ====================
# debug=true 时日志输出更详细、WebUI 绑定 127.0.0.1
DEBUG=false

# ==================== WebUI ====================
# 建议仅本机访问；对外暴露请使用反向代理并设置 WEBUI_TOKEN
WEBUI_HOST=127.0.0.1
WEBUI_PORT=9200
# 访问 WebUI 的令牌：留空则首次启动自动生成并写回本文件，登录时粘贴该值
# （也可手动填一个自己的强口令；启动横幅只在控制台打印，不写日志）
WEBUI_TOKEN=
# 启动后自动用浏览器打开 WebUI（打开的是带 ?accesstoken= 的一键登录链接，
# 进入后立刻换成会话 cookie 并把令牌从地址栏摘掉）。本地双击 start 脚本默认开启，
# 这里设为 true 可让直接跑 python main.py 时也自动打开。
WEBUI_AUTO_OPEN=false

# ==================== 数据 / 日志 ====================
# SQLite 数据库文件路径（相对项目根目录）
DB_PATH=data/app.db
# 日志目录
LOG_DIR=logs

# ==================== Bot 连接 ====================
# 首次连接超时（秒）
WS_CONNECT_TIMEOUT=30
# 心跳间隔（秒）
WS_PING_INTERVAL=30
# 心跳超时（秒）
WS_PING_TIMEOUT=10

# ==================== 调度器 ====================
# 定时任务（time_core）检查间隔（秒）
SCHEDULER_INTERVAL=30

# ==================== 模块目录 ====================
# 模块根目录（相对项目根目录；含 modules/ 插件主体、configs/ 迁移源、data/ 插件数据）
MODULE_DIR=module
