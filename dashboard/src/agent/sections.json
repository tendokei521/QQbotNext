{
  "version": 3,
  "note": "分区与段内分组的唯一权威。groups 里每一项是本页自己的子分组：用 fields 显式列字段（顺序即展示顺序），或用 source 收整组后端 group。retired 里的字段前端不再提供任何入口（被别的计划接管），后端字段保留。",
  "retired": {
    "note": "组装标准化由并行计划接管：信息感知成为固定流程（消息组装全面化 + 固定上传 tool），这些开关不再暴露给用户。后端字段与默认值保留，等那个计划落地后再一并退役。另：max_tokens（最大输出 Tokens）也在此退役——它只是「模型链全空时」的最后一层兜底，真正该改的地方是「Provider 预设 → 模型」页该模型的「最大输出 Token」（跟着模型走、带思考下限、日志写来源）。后端字段保留，供旧配置读取。",
    "fields": [
      "max_tokens",
      "include_time",
      "include_private_qq",
      "include_sender",
      "include_mentioned",
      "include_quote",
      "include_quote_sender",
      "include_sent",
      "fetch_at_nickname",
      "fetch_quote_content",
      "meta_sender_style",
      "meta_sent_style",
      "meta_instruction_mode",
      "meta_mask_nickname",
      "system_prompt_style",
      "proactive_prompt_enable",
      "proactive_history_intent_nudge",
      "proactive_env_prompt_enable",
      "proactive_unresolved_prompt_enable",
      "proactive_env_intent_nudge",
      "referent_prompt_enable",
      "context_expand_enable",
      "referent_resolve_enable",
      "referent_prefetch_enable",
      "referent_ambiguous_policy",
      "referent_prefetch_max",
      "referent_focus_ttl",
      "referent_focus_max",
      "tool_result_directive_enable",
      "tool_result_directive"
    ]
  },
  "sections": [
